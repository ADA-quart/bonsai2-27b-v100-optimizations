+        case GGML_UNARY_OP_SILU:
+            ggml_cuda_op_add_unary_mul_impl<op_silu>(ctx, add_node, unary_node, mul_node);
+            break;
+        default:
+            GGML_ABORT("Unsupported unary op for fused add+unary+mul");
+    }
