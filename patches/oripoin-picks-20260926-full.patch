+/* fused add + unary + mul */
+
+// add_node:   ADD(x, bias)
+// unary_node: UNARY(add_node)
+// mul_node:   MUL(unary_node, scale)
+// Output goes to mul_node->data. bias and scale are 1-D with ne[0] == x->ne[0]
+// and broadcast over the trailing dims, so the whole chain is one elementwise
+// pass over x's contiguous elements.
+template <float (*op)(float)>
+static void ggml_cuda_op_add_unary_mul_impl(ggml_backend_cuda_context & ctx,
+                                            ggml_tensor * add_node, ggml_tensor * unary_node, ggml_tensor * mul_node) {
+    const ggml_tensor * s0 = add_node->src[0];
+    const ggml_tensor * s1 = add_node->src[1];
+
+    const int64_t n = add_node->ne[0];
+
+    // the operand that broadcasts over dims 1..3 is the bias
+    const auto is_bias = [](const ggml_tensor * t) {
+        return t->ne[1] == 1 && t->ne[2] == 1 && t->ne[3] == 1;
+    };
+    const bool s1_is_bias = is_bias(s1) && !is_bias(s0);
+
+    const ggml_tensor * bias = s1_is_bias ? s1 : s0;
+    const ggml_tensor * x    = s1_is_bias ? s0 : s1;
+
+    const ggml_tensor * scale = (mul_node->src[0] == unary_node) ? mul_node->src[1] : mul_node->src[0];
