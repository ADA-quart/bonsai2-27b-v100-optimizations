+// The same tile from a q8_0 cache: the K/V rows are read where they lie - a dense window or, when the
+// row map is passed, the pool rows the session's columns name per (stream, query, slot) - and
+// dequantized into the same half2 tile the f16 loader fills, so every consumer below is unchanged and
+// no session-sized f16 copy exists. A thread's copy unit is 2*cpy_ne values (8 for 16-byte copies),
+// a quarter of a q8_0 block: the block's d is broadcast and the int8 values come from 2-byte loads
+// (a 4-byte load from the 2-byte-aligned qs field faults on this hardware).
+template<int warp_size, int nwarps, int I, int J, int J_padding, bool oob_check>
+static __device__ __forceinline__ void flash_attn_tile_load_tile_q8(
+        const block_q8_0 * const __restrict__ KV, const int32_t * const __restrict__ rows,
+        half2 * const __restrict__ tile_KV, const int stride_KV, const int k_0, const int i_sup) {
+    constexpr int cpy_nb = ggml_cuda_get_max_cpy_bytes();
+    constexpr int cpy_ne = cpy_nb / 4;
+    constexpr int unit_v = 2*cpy_ne; // values per copy unit
+
+    static_assert(J % 8 == 0, "bad J");
+    static_assert((J/2) % cpy_ne == 0, "bad J");
+    static_assert(unit_v <= QK8_0 && QK8_0 % unit_v == 0, "a copy unit must stay inside one q8_0 block");
+
+    auto load = [&] __device__ (const int n) {
+        const int stride_j = warp_size >> n;
+
+        if (stride_j == 0) {
+            return;
+        }
+
+        const int j0_start = stride_j == warp_size ? 0 : ((J/2)/cpy_ne) - ((J/2)/cpy_ne) % (2*stride_j);
+        const int j0_stop  =                             ((J/2)/cpy_ne) - ((J/2)/cpy_ne) % (1*stride_j);
+        const int stride_i = warp_size / stride_j;
+
+        if (j0_start == j0_stop) {
+            return;
+        }
+
+#pragma unroll
+        for (int i0 = 0; i0 < I; i0 += nwarps*stride_i) {
+            const int i = i0 + threadIdx.y*stride_i + (stride_j == warp_size ? 0 : threadIdx.x / stride_j);
+
+            if (i0 + nwarps*stride_i <= I || i < I) {
+                // the pool row this tile row reads; the map holds one list per (stream, query) and its
+                // stride is 0 for a uniform one, so its entry for a tile row is the entry at k_0 + i
+                const bool  valid = !oob_check || i < i_sup;
+                const int   k     = valid ? k_0 + i : k_0;
+                const block_q8_0 * row = KV + int64_t(rows ? rows[k] : k)*stride_KV;
+
+#pragma unroll
+                for (int j0 = j0_start; j0 < j0_stop; j0 += stride_j) {
+                    const int j = j0*cpy_ne + (stride_j == warp_size ? threadIdx.x : threadIdx.x % stride_j)*cpy_ne;
+
+                    __align__(16) half2 tmp[cpy_ne] = {{0.0f, 0.0f}};
+                    if (valid) {
+                        const int      v   = 2*j;
+                        const block_q8_0 * blk = row + v/QK8_0;
+                        const float    d   = __half2float(blk->d);
+                        const uint16_t * qs = (const uint16_t *) (blk->qs + (v % QK8_0));
+#pragma unroll
+                        for (int t = 0; t < cpy_ne; ++t) {
+                            const uint16_t w = qs[t];
+                            tmp[t] = make_half2(d*float(int8_t(w & 0xFF)), d*float(int8_t(w >> 8)));
+                        }
+                    }
+                    ggml_cuda_memcpy_1<cpy_nb>(tile_KV + i*(J/2 + J_padding) + j, tmp);
+                }
+            }
+        }
+    };
+    ggml_cuda_unroll<7>{}(load);
+}
