+// ---------------------------------------------------------------------------
+// Guard against stray tool-call markup.
+//
+// A small model at very long context sometimes emits only the TAIL of a tool call
+// ("</parameter>\n</function>\n</tool_call>", occasionally escaped), or a complete
+// <tool_call> block the parser could not turn into a tool call (seen on tool-less
+// requests such as Codex compaction turns). Without this guard the junk reaches the
+// client as plain assistant text and the turn ends there -- measured 4 times in 7344
+// assistant messages (0.05%) across the local sessions.
+//
+// Runs inside update_chat_msg() before the deltas are computed, so partial and final
+// parses stay consistent.
+// ---------------------------------------------------------------------------
+static size_t strip_stray_tool_markup(std::string & text, size_t * tail_removed = nullptr) {
+    size_t tail_total = 0;
+    // Covers the complete tags (</function>), the truncated forms the model also emits at long
+    // context (</function without '>'), and backslash-escaped spellings in either shape; the
+    // backslashes in front of a tag are swallowed together with it.
+    static const std::string bases[] = { "</parameter", "</function", "</tool_call", "<tool_call" };
+    static const std::string escaped_underscore = "tool\\_call";
+    size_t removed = 0;
+
+    // 1) whole <tool_call> ... </tool_call> blocks the parser did not recognise
+    for (;;) {
+        const size_t open = text.find("<tool_call>");
+        if (open == std::string::npos) {
+            break;
+        }
+        static const std::string close_tag = "</tool_call>";
+        const size_t close = text.find(close_tag, open);
+        const size_t end   = (close == std::string::npos) ? text.size() : close + close_tag.size();
+        removed += end - open;
+        text.erase(open, end - open);
+    }
+
+    // 2) tags (complete, truncated, or backslash-escaped) and <function=...> / tool\_call fragments
+    for (const auto & base : bases) {
+        size_t pos = 0;
+        while ((pos = text.find(base, pos)) != std::string::npos) {
+            size_t end = pos + base.size();
+            if (end < text.size() && text[end] == '>') {
+                end++;                                   // swallow a trailing '>' when present
+            }
+            size_t start = pos;
+            while (start > 0 && text[start - 1] == '\\') {
+                start--;                                 // swallow the escaping backslashes
+            }
+            removed += end - start;
+            text.erase(start, end - start);
+            pos = start;
+        }
+    }
+    for (const auto & needle : { escaped_underscore, std::string("<function=") }) {
+        size_t pos = 0;
+        while ((pos = text.find(needle, pos)) != std::string::npos) {
+            size_t end = pos + needle.size();
+            if (needle == "<function=") {
+                const size_t gt = text.find('>', pos);
+                if (gt == std::string::npos) {
+                    break;
+                }
+                end = gt + 1;
+            }
+            removed += end - pos;
+            text.erase(pos, end - pos);
+        }
+    }
+
+    // 3) a dangling fragment at the very end ("\\</", "\</", "</funct") left by a generation that
+    //    was cut off in the middle of a tag. Only the tail is touched, and only when the partial
+    //    name is empty or a prefix of a tag we know, so ordinary prose like "</div>" survives.
+    {
+        const size_t last = text.find_last_not_of(" \t\r\n");
+        if (last != std::string::npos) {
+            const size_t end = last + 1;
+            size_t k = end;
+            while (k > 0 && (isalnum((unsigned char) text[k - 1]) || text[k - 1] == '_' ||
+                             text[k - 1] == '\\')) {
+                k--;
+            }
+            if (k >= 2 && text[k - 1] == '/' && text[k - 2] == '<') {
+                std::string name;
+                for (size_t i = k; i < end; i++) {
+                    if (text[i] != '\\') {
+                        name.push_back(text[i]);
+                    }
+                }
+                static const char * known[] = { "parameter", "function", "tool_call", "tool",
+                                                "param", "funct", "func", "para", "par", "p", "f", "t", "c" };
+                bool looks_like_tag = name.empty();
+                for (const char * n : known) {
+                    if (!name.empty() && std::string(n).compare(0, name.size(), name) == 0) {
+                        looks_like_tag = true;
+                        break;
+                    }
+                }
+                if (looks_like_tag) {
+                    size_t start = k - 2;
+                    while (start > 0 && (text[start - 1] == '\\' || text[start - 1] == ' ')) {
+                        start--;
+                    }
+                    removed += end - start;
+                    tail_total += end - start;
+                    text.erase(start, end - start);
+                }
+            }
+        }
+    }
+
+    if (tail_removed != nullptr) {
+        *tail_removed = tail_total;
+    }
+    if (removed > 0) {
+        while (!text.empty() && (text.back() == '\n' || text.back() == '\r' || text.back() == ' ')) {
+            text.pop_back();
+        }
+    }
+    return removed;
+}
