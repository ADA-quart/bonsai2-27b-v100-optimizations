+    GGML_ASSERT(x->type == GGML_TYPE_F32 && ggml_is_contiguous(x));
+    GGML_ASSERT(bias->type == GGML_TYPE_F32 && ggml_is_contiguous(bias));
+    GGML_ASSERT(scale->type == GGML_TYPE_F32 && ggml_is_contiguous(scale));
+    GGML_ASSERT(mul_node->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_are_same_shape(mul_node, x));
+
+    GGML_ASSERT(bias->ne[0] == n && ggml_nelements(bias) == n);
+    GGML_ASSERT(scale->ne[0] == n && ggml_nelements(scale) == n);
+
+    cudaStream_t stream = ctx.stream();
+
+    unary_gated_add_cuda<op>((const float *) x->data, (const float *) bias->data, (const float *) scale->data,
+                             (float *) mul_node->data, ggml_nelements(x), n, stream);
+}
