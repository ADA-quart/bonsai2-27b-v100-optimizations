+// dst[i] = op(x[i] + b[i % n]) * g[i % n]
+// The GDN gating chain builds this as ADD bias -> softplus -> MUL scale. Both
+// the bias and the scale are 1-D and broadcast over dim 0 of a contiguous
+// [n, ...] operand, so they are indexed by the channel directly.
+template <float (*op)(float), typename T>
+static __global__ void unary_gated_add_op_kernel(const T * x, const T * b, const T * g, T * dst,
+                                                 const int64_t k, const int64_t n) {
+    ggml_cuda_pdl_lc();
+    const int64_t i = int64_t(blockDim.x)*blockIdx.x + threadIdx.x;
+
+    if (i >= k) {
+        return;
+    }
+
+    const int64_t c = i % n;
+
+    ggml_cuda_pdl_sync();
+    dst[i] = (T)(op((float)x[i] + (float)b[c]) * (float)g[c]);
+}
+
+template <float (*op)(float), typename T>
+static void unary_gated_add_cuda(const T * x, const T * b, const T * g, T * dst, const int64_t k, const int64_t n, cudaStream_t stream) {
+    const int64_t num_blocks = (k + CUDA_GLU_BLOCK_SIZE - 1) / CUDA_GLU_BLOCK_SIZE;
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params((dim3)num_blocks, CUDA_GLU_BLOCK_SIZE, 0, stream);
+    ggml_cuda_kernel_launch(unary_gated_add_op_kernel<op, T>, launch_params, x, b, g, dst, k, n);
+}
