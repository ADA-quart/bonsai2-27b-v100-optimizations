+// n_kv x n_ubatch f16 - are sized by that width, and clamping the ubatch only splits the target's
+// prefill chunks on the way in. It keeps the target's n_batch: the batches it is handed are the
+// target's.
+int32_t common_speculative_draft_n_ubatch(const common_params & params) {
+    // diagnostic escape hatch: set GGML_MTP_KEEP_DRAFT_UBATCH=1 to keep the target's ubatch
+    if (std::getenv("GGML_MTP_KEEP_DRAFT_UBATCH") != nullptr) {
+        return params.n_ubatch;
+    }
+    // local: one step of drafts is 1 + n_max rows, but this tree keeps a hybrid model's recurrent
+    // state rollback window (n_rs_seq == draft.n_max) inside one micro-batch, which needs n_max + 2
+    // rows. Take the larger of the two so the draft context keeps the rollback path instead of
+    // falling back to KV checkpoints at a 1 + n_max-sized ubatch.
+    const int64_t step_rows   = 1 + std::max<int64_t>(0, params.speculative.draft.n_max);
+    const int64_t window_rows = (int64_t) params.speculative.need_n_rs_seq() + 2;
+    const int64_t rows        = std::max<int64_t>(step_rows, window_rows) *
+                                std::max<int64_t>(1, params.n_parallel);
+
+    return (int32_t) std::max<int64_t>(1, std::min<int64_t>(params.n_ubatch, rows));
+}
