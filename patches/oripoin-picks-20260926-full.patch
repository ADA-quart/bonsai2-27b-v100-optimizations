@@ -246,6 +246,100 @@ static void concat_cuda(const ggml_tensor * src0, const ggml_tensor * src1, ggml
     }
 }
 
+// concat along dim 0, plus the checkpoint copies of the recurrent conv history that
+// follow it, in one pass. The copies only write elements this kernel just computed,
+// and each reads the same K-1 columns of every row at a fixed offset, so a thread
+// that already holds the value knows every slot it belongs in.
+//
+// ggml_cpy maps element i of src to element i of dst by flat index, and both sides
+// are contiguous, so the copy is a plain linear map. conv_input is [ne0, ne1, ne2]
+// = [K-1 + n_tokens, channels, n_seqs], so its flat row (i1, i2) is cache row i1 of
+// sequence i2, and the checkpoint's own [K-1, channels] shape makes its K-1 rows
+// consecutive: the row an element lands on is its column within the window.
+//
+// The window is narrow (K-1 + n_tokens, 5 in decode) and the channel count is wide,
+// so an index-per-thread layout keeps every lane busy where a block per (channel,
+// sequence) would run 5 of 256. Each block owns a slice of one sequence's flat
+// [channel, column] space and recovers the two indices with fastdiv.
+static __global__ void __launch_bounds__(CUDA_CONCAT_BLOCK_SIZE) concat_conv_state(
+        const char * __restrict__ src0,
+        const char * __restrict__ src1,
+        char * __restrict__ dst,
+        const int64_t ne00,
+        const int64_t ne0,
+        const int64_t ne1,
+        const uint64_t nb00,
+        const uint64_t nb01,
+        const uint64_t nb02,
+        const uint64_t nb10,
+        const uint64_t nb11,
+        const uint64_t nb12,
+        const uint64_t nb0,
+        const uint64_t nb1,
+        const uint64_t nb2,
+        const uint3 ne0_packed,
+        const ggml_cuda_conv_state_cpy cpy) {
+    const int64_t i2 = blockIdx.y;
+
+    ggml_cuda_pdl_sync();
+    // blocks live on x: the flattened (column, channel) space passes gridDim.y's 65535
+    // limit for a ubatch of a few thousand tokens, and a launch that large is rejected.
+    for (int64_t local = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         local < ne0*ne1;
+         local += (int64_t) gridDim.x * blockDim.x) {
+        const uint2 row_col = fast_div_modulo((uint32_t) local, ne0_packed);
+        const int64_t i1 = row_col.x;
+        const int64_t i0 = row_col.y;
+
+        const float v = i0 < ne00
+            ? *(const float *) (src0 + i2*nb02 + i1*nb01 + i0*nb00)
+            : *(const float *) (src1 + i2*nb12 + i1*nb11 + (i0 - ne00)*nb10);
+
+        *(float *) (dst + i2*nb2 + i1*nb1 + i0*nb0) = v;
+
+        // the element's column within its window picks the row it lands on, and the
+        // channel picks the position inside that row. The index is compile-time so the
+        // checkpoint fields stay in registers instead of local memory.
+        #pragma unroll
+        for (int k = 0; k < 4; ++k) {
+            if (k >= cpy.n_cpy) {
+                break;
+            }
+            const int64_t u0 = i0 - cpy.s_idx[k];
+            if (u0 >= 0 && u0 < cpy.n_rows) {
+                float * out = (float *) ((char *) cpy.dst[k] + i2*cpy.nb1);
+                out[u0 + cpy.n_rows*i1] = v;
+            }
+        }
+    }
+}
+
+void ggml_cuda_op_concat_conv_state(ggml_backend_cuda_context & ctx, ggml_tensor * dst,
+                                    const ggml_cuda_conv_state_cpy & cache) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+
+    cudaStream_t stream = ctx.stream();
+
+    // flatten (channel, column) per sequence so a block covers consecutive elements:
+    // the window alone is too narrow to fill a block on its own
+    const int64_t per_seq    = dst->ne[0]*dst->ne[1];
+    const int64_t num_blocks = (per_seq + CUDA_CONCAT_BLOCK_SIZE - 1) / CUDA_CONCAT_BLOCK_SIZE;
+
+    const dim3 grid_dim(num_blocks, dst->ne[2], 1);
+    const dim3 block_dim(CUDA_CONCAT_BLOCK_SIZE, 1, 1);
+
+    const uint3 ne0_packed = init_fastdiv_values(dst->ne[0]);
+
+    const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(grid_dim, block_dim, 0, stream);
+    ggml_cuda_kernel_launch(concat_conv_state, launch_params,
+            (const char *) src0->data, (const char *) src1->data, (char *) dst->data,
+            src0->ne[0], dst->ne[0], dst->ne[1],
+            src0->nb[0], src0->nb[1], src0->nb[2],
+            src1->nb[0], src1->nb[1], src1->nb[2],
+            dst->nb[0],  dst->nb[1],  dst->nb[2], ne0_packed, cache);
+}
