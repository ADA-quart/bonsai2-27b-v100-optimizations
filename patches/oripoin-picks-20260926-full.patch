@@ -44,6 +44,41 @@ typedef void (* fattn_kernel_t)(
 typedef float (*vec_dot_KQ_t)(
     const char * __restrict__ K_c, const void * __restrict__ Q_v, const int * __restrict__ Q_q8 , const void * __restrict__ Q_ds);
 
+// Whether the tile kernel reads a q8_0 cache where it lies, with no f16 materialisation and no
+// staging: that variant is compiled for the model's 256/256 head size, dequantizes into the half2
+// tile the f16 loader fills (so it needs fast fp16), and indexes K/V in whole q8_0 blocks, so every
+// stride it steps must be a whole number of them. The kernel choice, the node's size and the
+// launcher's f16 decision must agree: all three ask this one question. A pooled op may reach it
+// too - the kernel addresses the pool through the row map - as long as that map is a single list.
+static inline bool ggml_cuda_fattn_tile_reads_q8(const ggml_tensor * dst, const int device) {
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+
+    const int cc = ggml_cuda_info().devices[device].cc;
+
+    // the half2 tile exists on the NVIDIA devices whose compiled arch has fast fp16; the kernel's q8
+    // variant is compiled for those, and every other device keeps the f16 path it has today
+    if (!GGML_CUDA_CC_IS_NVIDIA(cc) || !fast_fp16_available(cc)) {
+        return false;
+    }
+    if (K->ne[0] != 256 || V->ne[0] != 256) {
+        return false;
+    }
+    if (K->type != GGML_TYPE_Q8_0 || V->type != GGML_TYPE_Q8_0) {
+        return false;
+    }
+    // the map, when there is one, has to be one list shared by every query column: a per-token map is
+    // the vec kernel's
+    if (dst->src[5] != nullptr && dst->src[5]->ne[1] != 1) {
+        return false;
+    }
+
+    const int64_t bs = sizeof(block_q8_0);
+
+    return K->nb[1] % bs == 0 && K->nb[2] % bs == 0 && K->nb[3] % bs == 0 &&
+           V->nb[1] % bs == 0 && V->nb[2] % bs == 0 && V->nb[3] % bs == 0;
+}
