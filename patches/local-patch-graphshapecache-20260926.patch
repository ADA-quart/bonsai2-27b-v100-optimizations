-static const void * ggml_cuda_graph_get_key(ggml_cgraph * cgraph) {
-    return cgraph->nodes[0];
+// [graphshapes] Per-shape hash used as part of the CUDA graph cache key when
+// GGML_CUDA_GRAPH_SHAPECACHE is set. Derived from the graph topology only
+// (node count + each node's op/ne/nb), so that stabilising the *shape* is enough
+// for a captured graph to be reused; changing tensor *addresses* are still
+// handled by cudaGraphExecUpdate(). Without the env var the hash is 0 and the
+// key degenerates to the historical "one graph per first-node pointer".
+static bool ggml_cuda_graph_shapecache_enabled() {
+    static const bool enabled = (getenv("GGML_CUDA_GRAPH_SHAPECACHE") != nullptr);
+    return enabled;
+}
+
+static uint64_t ggml_cuda_graph_shape_hash(const ggml_cgraph * cgraph) {
+    if (!ggml_cuda_graph_shapecache_enabled()) {
+        return 0;
+    }
+
+    uint64_t h = 1469598103934665603ull; // FNV-1a
+    auto mix = [&h](uint64_t v) { h ^= v; h *= 1099511628211ull; };
+
+    mix((uint64_t) cgraph->n_nodes);
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        if (node == nullptr) {
+            continue;
+        }
+        mix((uint64_t) node->op);
+        for (int d = 0; d < GGML_MAX_DIMS; d++) {
+            mix((uint64_t) node->ne[d]);
+            mix((uint64_t) node->nb[d]);
+        }
+    }
+
+    return h == 0 ? 1 : h;
+}
+
+static ggml_cuda_graph_key ggml_cuda_graph_get_key(ggml_cgraph * cgraph) {
+    return ggml_cuda_graph_key{ cgraph->nodes[0], ggml_cuda_graph_shape_hash(cgraph) };
+}
+
+// [ggtrace] temporary instrumentation, enabled with GGML_CUDA_GRAPH_TRACE=<n>
+// n = line budget (default 20000). Remove once the MTP graph-reuse question is settled.
+static bool ggt_enabled() {
+    static const char * env = getenv("GGML_CUDA_GRAPH_TRACE");
+    return env != nullptr;
+}
+
+static int ggt_budget() {
+    static int budget = [] {
+        const char * env = getenv("GGML_CUDA_GRAPH_TRACE");
+        if (env == nullptr) {
+            return 0;
+        }
+        const int v = atoi(env);
+        return v > 0 ? v : 20000;
+    }();
+    return budget;
+}
+
+static void ggt_log(const char * fmt, ...) {
+    static int used = 0;
+
+    if (!ggt_enabled() || used >= ggt_budget()) {
+        return;
+    }
+    used++;
+
+    va_list ap;
+    va_start(ap, fmt);
+    fputs("[ggt] ", stderr);
+    vfprintf(stderr, fmt, ap);
+    va_end(ap);
+    fflush(stderr);
 }
 
