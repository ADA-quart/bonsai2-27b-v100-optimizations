+// [graphshapes] Cache key for the per-context CUDA graph cache.
+// `shape` is 0 for the legacy behaviour (one graph per first-node pointer).
+// When GGML_CUDA_GRAPH_SHAPECACHE is set the graph gets a stable per-shape hash,
+// so a context that alternates between two batch shapes (e.g. the MTP draft
+// context: a 3-row verify batch alternating with a 1-row draft step) keeps one
+// captured graph per shape instead of resetting warmup and re-capturing on every
+// call.
+struct ggml_cuda_graph_key {
+    const void * first_node = nullptr;
+    uint64_t     shape      = 0;
+
+    bool operator==(const ggml_cuda_graph_key & other) const {
+        return first_node == other.first_node && shape == other.shape;
+    }
+};
+
+struct ggml_cuda_graph_key_hash {
+    size_t operator()(const ggml_cuda_graph_key & k) const {
+        return std::hash<const void *>()(k.first_node)
+             ^ (size_t) (k.shape * 0x9E3779B97F4A7C15ull);
+    }
+};
+
