{%- set image_count = namespace(value=0) %}
{%- set video_count = namespace(value=0) %}
{%- macro render_content(content, do_vision_count, is_system_content=false) %}
    {%- if content is string %}
        {{- content }}
    {%- elif content is iterable and content is not mapping %}
        {%- for item in content %}
            {%- if 'image' in item or 'image_url' in item or item.type == 'image' %}
                {%- if is_system_content %}
                    {{- raise_exception('System message cannot contain images.') }}
                {%- endif %}
                {%- if do_vision_count %}
                    {%- set image_count.value = image_count.value + 1 %}
                {%- endif %}
                {%- if add_vision_id %}
                    {{- 'Picture ' ~ image_count.value ~ ': ' }}
                {%- endif %}
                {{- '<|vision_start|><|image_pad|><|vision_end|>' }}
            {%- elif 'video' in item or item.type == 'video' %}
                {%- if is_system_content %}
                    {{- raise_exception('System message cannot contain videos.') }}
                {%- endif %}
                {%- if do_vision_count %}
                    {%- set video_count.value = video_count.value + 1 %}
                {%- endif %}
                {%- if add_vision_id %}
                    {{- 'Video ' ~ video_count.value ~ ': ' }}
                {%- endif %}
                {{- '<|vision_start|><|video_pad|><|vision_end|>' }}
            {%- elif 'text' in item %}
                {{- item.text }}
            {%- else %}
                {{- raise_exception('Unexpected item type in content.') }}
            {%- endif %}
        {%- endfor %}
    {%- elif content is none or content is undefined %}
        {{- '' }}
    {%- else %}
        {{- raise_exception('Unexpected content type.') }}
    {%- endif %}
{%- endmacro %}
{%- if not messages %}
    {{- raise_exception('No messages provided.') }}
{%- endif %}
{%- set reasoning_instructions = '' %}
{#- "thinking off" comes either from the server (--reasoning off -> enable_thinking=false) or from a
    per-request level: OpenAI/Codex clients send reasoning.effort = "none" when the user picks "off". #}
{%- set think_disabled = (enable_thinking is defined and enable_thinking is false) %}
{%- if not think_disabled %}
    {%- set resolved_reasoning_effort = (reasoning_effort|default('xhigh'))|lower %}
    {%- if resolved_reasoning_effort in ('none', 'off', 'disabled', 'false', '0') %}
        {%- set think_disabled = true %}
    {%- else %}
        {%- if resolved_reasoning_effort not in ('xhigh', 'medium', 'low') %}
            {#- clients send their own effort names (Codex: high/max/ultra, others: minimal): map them instead of failing #}
            {%- if resolved_reasoning_effort in ('high', 'max', 'ultra', 'very_high') %}
                {%- set resolved_reasoning_effort = 'xhigh' %}
            {%- elif resolved_reasoning_effort in ('minimal', 'tiny') %}
                {%- set resolved_reasoning_effort = 'low' %}
            {%- else %}
                {%- set resolved_reasoning_effort = 'medium' %}
            {%- endif %}
        {%- endif %}
        {%- if resolved_reasoning_effort == 'xhigh' %}
            {%- set reasoning_instructions = 'Reasoning effort is set to xhigh. Please think carefully through the task, validate key assumptions, consider plausible alternatives, and prioritize correctness, consistency, and clarity in the final answer. Write the entire thinking block in Simplified Chinese (用简体中文思考，不要用英文).' %}
        {%- elif resolved_reasoning_effort == 'low' %}
            {%- set reasoning_instructions = 'Reasoning effort is set to low. Keep your thinking brief and focused, moving directly to the conclusion without unnecessary elaboration. Write the entire thinking block in Simplified Chinese (用简体中文思考，不要用英文).' %}
        {%- elif resolved_reasoning_effort == 'medium' %}
            {%- set reasoning_instructions = 'Reasoning effort is set to medium. Think through the task at a balanced depth and keep the final answer clear. Write the entire thinking block in Simplified Chinese (用简体中文思考，不要用英文).' %}
        {%- endif %}
    {%- endif %}
{%- endif %}
{%- if tools and tools is iterable and tools is not mapping %}
    {{- '<|im_start|>system\n' }}
    {%- if reasoning_instructions %}
        {{- reasoning_instructions + '\n\n' }}
    {%- endif %}
    {{- "# Tools\n\nYou have access to the following functions:\n\n<tools>" }}
    {%- for tool in tools %}
        {{- "\n" }}
        {{- tool | tojson }}
    {%- endfor %}
    {{- "\n</tools>" }}
    {{- '\n\n工具选择速查（本机固定规则，优先于你的直觉）：\n' }}
    {{- '1) 读/写**本机文件**只用 exec_command（Get-Content / cat / rg / Get-ChildItem）或 apply_patch；' }}
    {{- '如果工具列表里出现 read_mcp_resource / list_mcp_resources，它们只能访问 MCP 服务器自己暴露的资源（plugin:// 这类），**不能拿来读本机文件**。\n' }}
    {{- '2) exec_command 返回 session_id 之后才可以用 write_stdin，而且只能用那个 id；进程已结束时不要再 write_stdin。\n' }}
    {{- '3) 参数必须有实际内容：cmd / path / uri 之类留空会被直接拒绝。\n' }}
    {{- '4) 同一个命令最多执行 2 次；输出为空就是结论（没有匹配 / 没有改动）；同一个工具失败 2 次就换工具，不要换着参数硬试。\n' }}
    {{- '5) 本仓库的修改一律用 apply_patch（不要用 echo/重定向写文件）。\n' }}
    {{- '6) 正确调用示例（照抄结构，只换真实路径）：读文件 → exec_command，cmd = Get-Content -Path "C:\\Projects\\itdc\\src\\diag.ts" -Encoding UTF8；' }}
    {{- '搜索 → exec_command，cmd = rg -n "scheduler" C:\\Projects\\itdc\\src；找文件 → exec_command，cmd = rg --files C:\\Projects\\itdc；' }}
    {{- '改文件 → apply_patch（*** Begin Patch ... *** End Patch）；看长驻进程 → 只有 exec_command 返回 session_id=123 且进程未结束时才 write_stdin（session_id = 123，chars = ""）。\n' }}
    {{- '7) 禁止：空参数调用；用 MCP 资源工具读本机文件；对已结束的进程 write_stdin；同一命令第 3 次重试。\n' }}
    {{- '\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<tool_call>\n<function=example_function_name>\n<parameter=example_parameter_1>\nvalue_1\n</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n</tool_call>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format: an inner <function=...></function> block must be nested within <tool_call></tool_call> XML tags\n- Required parameters MUST be specified\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n</IMPORTANT>' }}
    {%- if messages[0].role == 'system' %}
        {%- set content = render_content(messages[0].content, false, true)|trim %}
        {%- if content %}
            {{- '\n\n' + content }}
        {%- endif %}
    {%- endif %}
    {{- '<|im_end|>\n' }}
{%- else %}
    {%- if messages[0].role == 'system' %}
        {%- set content = render_content(messages[0].content, false, true)|trim %}
        {%- if content %}
            {{- '<|im_start|>system\n' + (reasoning_instructions + '\n\n' if reasoning_instructions else '')  + content + '<|im_end|>\n' }}
        {%- elif reasoning_instructions %}
            {{- '<|im_start|>system\n' + reasoning_instructions + '<|im_end|>\n' }}
        {%- endif %}
    {%- elif reasoning_instructions %}
        {{- '<|im_start|>system\n' + reasoning_instructions + '<|im_end|>\n' }}
    {%- endif %}
{%- endif %}
{%- set ns = namespace(multi_step_tool=true, last_query_index=messages|length - 1) %}
{%- for message in messages[::-1] %}
    {%- set index = (messages|length - 1) - loop.index0 %}
    {%- if ns.multi_step_tool and message.role == "user" %}
        {%- set content = render_content(message.content, false)|trim %}
        {%- if not(content.startswith('<tool_response>') and content.endswith('</tool_response>')) %}
            {%- set ns.multi_step_tool = false %}
            {%- set ns.last_query_index = index %}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{%- if ns.multi_step_tool %}
    {{- raise_exception('No user query found in messages.') }}
{%- endif %}
{#- 循环检测：统计"连续完全相同的工具调用"次数；≥3 次时把警告塞进**最后一条消息**（工具输出或用户消息）
    里——位置紧贴生成点（注意力最高），同时不新增消息、不破坏服务器的 peg-native 解析。 -#}
{%- set guard = namespace(run=0, sig='', tool='', note='', same_tool=0, last_fail=false, last_out='', fidx=0) %}
{%- for m in messages %}
    {%- if m.role == 'assistant' and m.tool_calls is defined and m.tool_calls is iterable and m.tool_calls is not mapping and m.tool_calls|length > 0 %}
        {%- set tc = m.tool_calls[0] %}
        {%- set fn = tc.function if tc.function is defined else tc %}
        {%- set gname = fn.name|string %}
        {%- set gsig = (fn.name|string) + '|' + (fn.arguments|tojson) %}
        {%- if gsig == guard.sig %}
            {%- set guard.run = guard.run + 1 %}
        {%- else %}
            {%- set guard.sig = gsig %}
            {%- set guard.run = 1 %}
            {%- set guard.tool = gname %}
        {%- endif %}
        {#- 同名工具连续调用计数（不看参数）：用来抓"参数写坏 / 换着参数重试"的失败循环 -#}
        {%- if gname == guard.tool %}
            {%- set guard.same_tool = guard.same_tool + 1 %}
        {%- else %}
            {%- set guard.same_tool = 1 %}
            {%- set guard.tool = gname %}
            {%- set guard.sig = gsig %}
            {%- set guard.run = 1 %}
        {%- endif %}
    {%- elif m.role == 'tool' %}
        {%- set mtext = (render_content(m.content, false)|trim)|lower %}
        {%- set guard.last_fail = ('failed' in mtext) or ('error' in mtext) or ('unknown' in mtext) or ('invalid' in mtext) or ('denied' in mtext) or ('cannot' in mtext) %}
        {%- set guard.last_out = mtext[:160] %}
    {%- endif %}
{%- endfor %}
{%- if guard.run >= 3 %}
    {%- set tnames = namespace(list='') %}
    {%- if tools is defined and tools is iterable and tools is not mapping %}
        {%- for t in tools %}
            {%- set tname = t.function.name if t.function is defined else t.name|default('') %}
            {%- set tnames.list = tnames.list + (tname|string) + ' ' %}
        {%- endfor %}
    {%- endif %}
    {%- set guard.note = '\n\n[系统·循环检测] 你已经连续 ' + (guard.run|string) + ' 次发出**完全相同**的工具调用（' + guard.tool + '，参数一模一样）。这一轮**禁止再调用它**：直接基于上面的输出给出结论或修改文件，或者改用不同的命令' + ('（可用工具：' + (tnames.list|trim) + '）' if tnames.list|trim else '') + '。重复同一个调用会被视为卡死。' %}
{%- elif guard.same_tool >= 3 and guard.last_fail %}
    {%- set tnames2 = namespace(list='') %}
    {%- if tools is defined and tools is iterable and tools is not mapping %}
        {%- for t in tools %}
            {%- set tname2 = t.function.name if t.function is defined else t.name|default('') %}
            {%- set tnames2.list = tnames2.list + (tname2|string) + ' ' %}
        {%- endfor %}
    {%- endif %}
    {%- set guard.note = '\n\n[系统·循环检测] 你已经连续 ' + (guard.same_tool|string) + ' 次调用同一个工具（' + guard.tool + '），而且**每次都失败**（最近一次输出：' + guard.last_out + '）。**禁止再用这个工具重试**：读本地文件请用 exec_command（Get-Content / cat / rg），MCP 的资源工具（list_mcp_resources / read_mcp_resource）只能用于 MCP 服务器自己暴露的资源，不能拿来读本机文件。要么换工具/换命令，要么直接说明卡在哪、需要用户做什么。' + ('（可用工具：' + (tnames2.list|trim) + '）' if tnames2.list|trim else '') %}
{%- endif %}
{%- for message in messages %}
    {%- set content = render_content(message.content, true)|trim %}
    {%- if message.role == "system" %}
        {%- if not loop.first %}
            {#- clients such as Codex append system/developer notes mid-conversation: render them, do not fail #}
            {{- '<|im_start|>system\n' + content + '<|im_end|>\n' }}
        {%- endif %}
    {%- elif message.role == "user" %}
        {{- '<|im_start|>' + message.role + '\n' + content + (guard.note if loop.last else '') + '<|im_end|>' + '\n' }}
    {%- elif message.role == "assistant" %}
        {%- set reasoning_content = '' %}
        {%- if message.reasoning_content is string %}
            {%- set reasoning_content = message.reasoning_content %}
        {%- endif %}
        {%- set reasoning_content = reasoning_content|trim %}
        {%- if preserve_thinking is undefined or preserve_thinking is true or loop.index0 > ns.last_query_index %}
            {{- '<|im_start|>' + message.role + '\n<think>\n' + reasoning_content + '\n</think>\n\n' + content }}
        {%- else %}
            {{- '<|im_start|>' + message.role + '\n' + content }}
        {%- endif %}
        {%- if message.tool_calls and message.tool_calls is iterable and message.tool_calls is not mapping %}
            {%- for tool_call in message.tool_calls %}
                {%- if tool_call.function is defined %}
                    {%- set tool_call = tool_call.function %}
                {%- endif %}
                {%- if loop.first %}
                    {%- if content|trim %}
                        {{- '\n\n<tool_call>\n<function=' + tool_call.name + '>\n' }}
                    {%- else %}
                        {{- '<tool_call>\n<function=' + tool_call.name + '>\n' }}
                    {%- endif %}
                {%- else %}
                    {{- '\n<tool_call>\n<function=' + tool_call.name + '>\n' }}
                {%- endif %}
                {%- if tool_call.arguments is defined and tool_call.arguments != '' %}
                    {%- for args_name, args_value in tool_call.arguments|items %}
                        {{- '<parameter=' + args_name + '>\n' }}
                        {%- set args_value = args_value | string if args_value is string else args_value | tojson | safe %}
                        {{- args_value }}
                        {{- '\n</parameter>\n' }}
                    {%- endfor %}
                {%- endif %}
                {{- '</function>\n</tool_call>' }}
            {%- endfor %}
        {%- endif %}
        {{- '<|im_end|>\n' }}
    {%- elif message.role == "tool" %}
        {%- if loop.previtem and loop.previtem.role != "tool" %}
            {{- '<|im_start|>user' }}
        {%- endif %}
        {{- '\n<tool_response>\n' }}
        {{- content }}
        {%- if loop.last %}{{- guard.note }}{%- endif %}
        {{- '\n</tool_response>' }}
        {%- if not loop.last and loop.nextitem.role != "tool" %}
            {{- '<|im_end|>\n' }}
        {%- elif loop.last %}
            {{- '<|im_end|>\n' }}
        {%- endif %}
    {%- else %}
        {{- raise_exception('Unexpected message role.') }}
    {%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}
    {{- '<|im_start|>assistant\n' }}
    {%- if think_disabled %}
        {{- '<think>\n\n</think>\n\n' }}
    {%- else %}
        {{- '<think>\n' }}
    {%- endif %}
{%- endif %}
